--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -98,6 +98,10 @@ jobs:
           - runner: macos-15
             os: darwin
             arch: arm64
+          # Cross-compile Windows amd64 (binaries + Go Setup.exe) from Linux.
+          - runner: ubuntu-24.04
+            os: windows
+            arch: amd64
     runs-on: ${{ matrix.runner }}
     timeout-minutes: 30
     steps:
@@ -147,13 +151,19 @@ jobs:
           bash scripts/package-release.sh --version "$RELEASE_VERSION" \
             --os "$GOOS" --arch "$GOARCH" --with-sidecar \
             --base-url "https://github.com/$RELEASE_REPO/releases/download/$RELEASE_VERSION"
-          ./bin/amux --version
+          if [ "$GOOS" != windows ]; then
+            ./bin/amux --version
+          else
+            test -f ./bin/Setup.exe
+            test -f ./bin/amux.exe
+          fi
           mv dist/latest.json "dist/manifest_${GOOS}_${GOARCH}.json"
       - uses: actions/upload-artifact@v4
         with:
           name: release-${{ matrix.os }}-${{ matrix.arch }}
           path: |
             dist/*.tar.gz
+            dist/*_Setup.exe
             dist/*.sha256
             dist/manifest_*.json
           if-no-files-found: error
@@ -189,5 +199,5 @@ jobs:
               --title "amux $RELEASE_VERSION" --notes-file dist/notes.md
           fi
           gh release upload "$RELEASE_VERSION" --repo "$RELEASE_REPO" --clobber \
-            dist/*.tar.gz dist/*.sha256 dist/latest.json dist/version.txt dist/install.sh
+            dist/*.tar.gz dist/*_Setup.exe dist/*.sha256 dist/latest.json dist/version.txt dist/install.sh
           gh release edit "$RELEASE_VERSION" --repo "$RELEASE_REPO" --draft=false --latest
